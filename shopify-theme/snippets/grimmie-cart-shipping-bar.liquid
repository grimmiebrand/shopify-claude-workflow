{%- doc -%}
  Grimmie - free-shipping progress bar for the cart drawer.

  Reads the header section settings (editable in Theme editor -> Header -> "Carrello (drawer)"):
    section.settings.free_shipping_threshold (euro). Falls back to the shop metafield
    custom.free_shipping_threshold (money, already in cents); if neither is valid it is hidden.

  Calculations use minor units (cents). cart.total_price is already in cents.
  Re-renders with the cart summary on every AJAX cart update (no custom JS needed).
  @param {object} section - the header section (provides settings)
{%- enddoc -%}

{%- unless section.settings.show_free_shipping_progress == false -%}
  {%- liquid
    assign threshold_cents = 0
    if section.settings.free_shipping_threshold > 0
      assign threshold_cents = section.settings.free_shipping_threshold | times: 100 | round
    endif
    if threshold_cents == 0
      assign mf = shop.metafields.custom.free_shipping_threshold
      if mf != blank and mf.value != blank
        assign threshold_cents = mf.value | round
      endif
    endif
  -%}

  {%- if threshold_cents > 0 -%}
    {%- liquid
      assign total_cents = cart.total_price
      assign remaining_cents = threshold_cents | minus: total_cents
      if remaining_cents < 0
        assign remaining_cents = 0
      endif
      assign progress = total_cents | times: 100 | divided_by: threshold_cents
      if progress > 100
        assign progress = 100
      endif
      assign remaining_money = remaining_cents | money
      assign pending_tpl = section.settings.free_shipping_pending_text | default: 'Ti mancano {amount} per la spedizione gratuita'
      assign pending_text = pending_tpl | replace: '{{ amount }}', remaining_money | replace: '{amount}', remaining_money
      assign reached_text = section.settings.free_shipping_reached_text | default: 'Hai sbloccato la spedizione gratuita &#10024;'
    -%}
    <div class="g-ship">
      <div class="g-ship__row">
        <span class="g-ship__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4.5h13v10H1z"/><path d="M14 8.5h4l3 3v3h-7z"/><circle cx="5.5" cy="17.5" r="1.7"/><circle cx="17.5" cy="17.5" r="1.7"/></svg>
        </span>
        <p class="g-ship__text">
          {%- if remaining_cents == 0 -%}{{ reached_text }}{%- else -%}{{ pending_text }}{%- endif -%}
        </p>
        {%- if remaining_cents > 0 and section.settings.show_shipping_values != false -%}
          <span class="g-ship__values">{{ cart.total_price | money }} / {{ threshold_cents | money }}</span>
        {%- endif -%}
      </div>
      <div
        class="g-ship__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="{{ threshold_cents }}"
        aria-valuenow="{{ total_cents }}"
        aria-label="{{ 'Progresso spedizione gratuita' }}"
      >
        <span class="g-ship__fill" style="width: {{ progress }}%;"></span>
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}
