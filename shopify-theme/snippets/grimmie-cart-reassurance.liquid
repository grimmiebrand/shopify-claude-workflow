{%- doc -%}
  Grimmie - reassurance strip at the bottom of the cart drawer.
  Texts/visibility editable in Theme editor -> Header -> "Carrello (drawer)".
  @param {object} section - the header section (provides settings)
{%- enddoc -%}

{%- unless section.settings.show_cart_reassurance == false -%}
  {%- liquid
    assign r1_title = section.settings.cart_reassurance_1_title | default: 'Resi facili'
    assign r1_text = section.settings.cart_reassurance_1_text | default: 'entro 30 giorni'
    assign r2_title = section.settings.cart_reassurance_2_title | default: 'Pagamenti sicuri'
    assign r2_text = section.settings.cart_reassurance_2_text
  -%}
  <div class="g-reassure" role="group" aria-label="{{ 'Vantaggi' }}">
    <div class="g-reassure__col">
      <span class="g-reassure__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v5h-5"/></svg>
      </span>
      <span class="g-reassure__title">{{ r1_title }}</span>
      {%- if r1_text != blank -%}<span class="g-reassure__text">{{ r1_text }}</span>{%- endif -%}
    </div>
    <div class="g-reassure__col">
      <span class="g-reassure__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      </span>
      <span class="g-reassure__title">{{ r2_title }}</span>
      {%- if r2_text != blank -%}<span class="g-reassure__text">{{ r2_text }}</span>{%- endif -%}
    </div>
  </div>
{%- endunless -%}
