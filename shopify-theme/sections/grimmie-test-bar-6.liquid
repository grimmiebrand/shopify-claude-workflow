<div>T6 {{ section.id }}</div>

{% schema %}
{
  "name": "Grimmie Scrolling Announcement",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label (screen readers)",
      "default": "Annunci e vantaggi"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scrolling",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Loop duration (seconds)",
      "info": "Lower = faster scroll. Suggested 30\u201360.",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        {
          "value": "left",
          "label": "Right \u2192 Left"
        },
        {
          "value": "right",
          "label": "Left \u2192 Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_icon",
      "label": "Divider icon",
      "options": [
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "dotdash",
          "label": "Dot + dash"
        },
        {
          "value": "slash",
          "label": "Diagonal slash"
        }
      ],
      "default": "sparkle"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F7F1EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6E5F59"
    }
  ]
}
{% endschema %}