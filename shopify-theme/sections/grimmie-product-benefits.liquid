{%- liquid
  assign sid = section.id
  assign s = section.settings
-%}

<style>
  .gpb-{{ sid }} {
    --gpb-bg: {{ s.background_color }};
    --gpb-heading: {{ s.heading_color }};
    --gpb-text: {{ s.text_color }};
    --gpb-accent: {{ s.accent_color }};
    --gpb-border: {{ s.border_color }};
    background-color: var(--gpb-bg);
    color: var(--gpb-text);
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body--family);
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
  }
  .gpb-{{ sid }} * { box-sizing: border-box; }
  .gpb-{{ sid }}__inner { max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 56px); }
  .gpb-{{ sid }}__title {
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    color: var(--gpb-heading);
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0 0 clamp(28px, 3.4vw, 44px);
  }
  .gpb-{{ sid }}__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .gpb-{{ sid }}__item {
    text-align: center;
    padding: 4px clamp(14px, 1.6vw, 24px);
    border-left: 1px solid var(--gpb-border);
  }
  .gpb-{{ sid }}__item:first-child { border-left: 0; }
  .gpb-{{ sid }}__icon {
    width: 44px;
    height: 44px;
    margin: 0 auto 16px;
    color: var(--gpb-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gpb-{{ sid }}__icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .gpb-{{ sid }}__icon img { width: 100%; height: 100%; object-fit: contain; }
  .gpb-{{ sid }}__item-title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    color: var(--gpb-heading);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.25;
    margin: 0 0 8px;
  }
  .gpb-{{ sid }}__item-text {
    font-size: clamp(13px, 0.95vw, 14.5px);
    line-height: 1.55;
    color: var(--gpb-text);
    margin: 0;
    max-width: 24ch;
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 749px) {
    .gpb-{{ sid }}__grid { grid-template-columns: 1fr 1fr; gap: clamp(28px, 6vw, 36px) 0; }
    .gpb-{{ sid }}__item { padding: 0 16px; border-left: 1px solid var(--gpb-border); }
    .gpb-{{ sid }}__item:nth-child(odd) { border-left: 0; }
  }
</style>

<section class="gpb-{{ sid }}" aria-label="{{ s.title | default: 'Benefici' | escape }}">
  <div class="gpb-{{ sid }}__inner">
    {%- if s.title != blank -%}<h2 class="gpb-{{ sid }}__title">{{ s.title | escape }}</h2>{%- endif -%}
    <div class="gpb-{{ sid }}__grid">
      {%- for block in section.blocks -%}
        <div class="gpb-{{ sid }}__item" {{ block.shopify_attributes }}>
          <span class="gpb-{{ sid }}__icon"{% if block.settings.icon_image == blank %} aria-hidden="true"{% endif %}>
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 120 | image_tag: alt: block.settings.icon_alt, loading: 'lazy', widths: '44,88,120' }}
            {%- else -%}
            {%- case block.settings.icon -%}
              {%- when 'pouch' -%}
                <svg viewBox="0 0 24 24"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M8 8a4 4 0 0 1 8 0"/></svg>
              {%- when 'droplet' -%}
                <svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
              {%- when 'airplane' -%}
                <svg viewBox="0 0 24 24"><path d="M10.5 13.5 3 11l2-2 6 1 4.5-4.5a2 2 0 0 1 2.8 2.8L14 12l1 6-2 2-2.5-7.5z"/></svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 24 24"><path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M11 21C5 21 3 16 3 11 9 11 11 6 21 5c0 8-4 16-10 16z"/><path d="M7 17C12 12 14 10 18 8"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.6-9.5-9A4.8 4.8 0 0 1 12 7a4.8 4.8 0 0 1 9.5 5C19 16.4 12 21 12 21z"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z"/></svg>
            {%- endcase -%}
            {%- endif -%}
          </span>
          {%- if block.settings.title != blank -%}<h3 class="gpb-{{ sid }}__item-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="gpb-{{ sid }}__item-text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grimmie benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Perché scegliere Alma" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F1EBE6" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#6E5F59" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#6E5F59" },
    { "type": "color", "id": "accent_color", "label": "Icon color", "default": "#C99696" },
    { "type": "color", "id": "border_color", "label": "Divider", "default": "#DDD2CA" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "pouch",
          "options": [
            { "value": "pouch", "label": "Pouch / bag" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "airplane", "label": "Airplane" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" }
          ],
          "info": "Used only if no custom icon image is uploaded below."
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)", "info": "Upload your own icon. Replaces the icon above. Use a small square PNG/SVG." },
        { "type": "text", "id": "icon_alt", "label": "Custom icon alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ordine quotidiano" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Tutto al suo posto, ogni giorno." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grimmie benefits",
      "category": "Grimmie",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "pouch", "title": "Ordine quotidiano", "text": "Tutto al suo posto, ogni giorno." } },
        { "type": "benefit", "settings": { "icon": "droplet", "title": "Materiali lavabili", "text": "Interno facile da pulire, sempre impeccabile." } },
        { "type": "benefit", "settings": { "icon": "airplane", "title": "Perfette in viaggio", "text": "Leggere, resistenti e salvaspazio." } },
        { "type": "benefit", "settings": { "icon": "sparkle", "title": "Set coordinato", "text": "Due misure, un solo stile senza tempo." } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
