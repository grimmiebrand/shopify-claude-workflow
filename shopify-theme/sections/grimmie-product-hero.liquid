{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign cur = product.selected_or_first_available_variant
  assign has_compare = false
  if cur.compare_at_price > cur.price
    assign has_compare = true
    assign saving = cur.compare_at_price | minus: cur.price
  endif
  assign form_id = 'gph-form-' | append: sid
  assign form_class = 'gph-' | append: sid | append: '__form'
-%}

<style>
  .gph-{{ sid }} {
    --gph-bg: {{ s.background_color }};
    --gph-panel-bg: {{ s.panel_background_color }};
    --gph-heading: {{ s.heading_color }};
    --gph-text: {{ s.text_color }};
    --gph-accent: {{ s.accent_color }};
    --gph-blush: {{ s.blush_color }};
    --gph-blush-lt: {{ s.blush_light_color }};
    --gph-border: {{ s.border_color }};
    --gph-btn-bg: {{ s.button_background_color }};
    --gph-btn-text: {{ s.button_text_color }};
    --gph-btn-hover: {{ s.button_hover_background_color }};
    background-color: var(--gph-bg);
    color: var(--gph-text);
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body--family);
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
  }
  .gph-{{ sid }} * { box-sizing: border-box; }
  .gph-{{ sid }}__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  /* ---------- Gallery ---------- */
  .gph-{{ sid }}__gallery { position: relative; }
  .gph-{{ sid }}__sel { position: absolute; opacity: 0; pointer-events: none; }
  .gph-{{ sid }}__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--gph-blush-lt);
  }
  .gph-{{ sid }}__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .gph-{{ sid }}__slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gph-{{ sid }}__slide:first-of-type { opacity: 1; }
  .gph-{{ sid }}__zoom {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gph-bg);
    border: 1px solid var(--gph-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gph-accent);
  }
  .gph-{{ sid }}__zoom svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .gph-{{ sid }}__thumbs {
    display: grid;
    grid-template-columns: repeat({{ s.thumb_columns | default: 4 }}, 1fr);
    gap: 12px;
    margin-top: 12px;
  }
  .gph-{{ sid }}__thumb {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--gph-border);
    cursor: pointer;
    background-color: var(--gph-blush-lt);
    transition: border-color 0.2s ease;
  }
  .gph-{{ sid }}__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- Panel ---------- */
  .gph-{{ sid }}__panel { display: flex; flex-direction: column; }
  .gph-{{ sid }}__badge {
    align-self: flex-start;
    background-color: var(--gph-blush);
    color: var(--gph-heading);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .gph-{{ sid }}__title {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    color: var(--gph-heading);
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    text-transform: none;
  }
  .gph-{{ sid }}__subtitle {
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.55;
    color: var(--gph-text);
    margin: 0 0 18px;
  }
  .gph-{{ sid }}__price-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
  .gph-{{ sid }}__price { font-size: clamp(22px, 2.2vw, 28px); font-weight: 600; color: var(--gph-heading); }
  .gph-{{ sid }}__compare { font-size: 17px; color: var(--gph-text); opacity: 0.55; text-decoration: line-through; }
  .gph-{{ sid }}__saving {
    background-color: var(--gph-blush-lt);
    color: var(--gph-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 6px;
  }
  .gph-{{ sid }}__opt-title {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--gph-heading);
    margin: 0 0 10px;
  }
  .gph-{{ sid }}__options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 22px; }
  .gph-{{ sid }}__opt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 2px;
    padding: 14px 8px;
    border: 1px solid var(--gph-border);
    border-radius: 12px;
    background-color: var(--gph-bg);
    text-decoration: none;
    color: var(--gph-text);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .gph-{{ sid }}__opt:hover { border-color: var(--gph-blush); }
  .gph-{{ sid }}__opt--active { border-color: var(--gph-blush); border-width: 2px; background-color: var(--gph-blush-lt); }
  .gph-{{ sid }}__opt-name { font-weight: 500; font-size: 14px; color: var(--gph-heading); }
  .gph-{{ sid }}__opt-price { font-size: 13px; color: var(--gph-text); }
  .gph-{{ sid }}__opt-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background-color: var(--gph-blush);
    color: var(--gph-heading);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 999px;
  }
  .gph-{{ sid }}__opt-check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--gph-blush);
    color: #fff;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .gph-{{ sid }}__opt--active .gph-{{ sid }}__opt-check { display: flex; }
  .gph-{{ sid }}__opt-check svg { width: 11px; height: 11px; fill: none; stroke: var(--gph-heading); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

  .gph-{{ sid }}__bullets { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .gph-{{ sid }}__bullet { display: flex; align-items: flex-start; gap: 10px; font-size: clamp(13px, 1vw, 14.5px); line-height: 1.45; color: var(--gph-text); }
  .gph-{{ sid }}__bullet-icon { flex: 0 0 auto; width: 18px; height: 18px; margin-top: 1px; border-radius: 50%; border: 1px solid var(--gph-blush); display: flex; align-items: center; justify-content: center; color: var(--gph-accent); }
  .gph-{{ sid }}__bullet-icon svg { width: 10px; height: 10px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .gph-{{ sid }}__form { display: flex; flex-direction: column; gap: 12px; margin: 0; }
  .gph-{{ sid }}__btn {
    width: 100%;
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border-radius: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .gph-{{ sid }}__btn--add { background-color: var(--gph-btn-bg); color: var(--gph-btn-text); border: none; }
  .gph-{{ sid }}__btn--add:hover { background-color: var(--gph-btn-hover); color: var(--gph-bg); }
  .gph-{{ sid }}__btn--add[disabled] { opacity: 0.5; cursor: not-allowed; }
  .gph-{{ sid }}__btn--buy { background-color: transparent; color: var(--gph-heading); border: 1px solid var(--gph-border); }
  .gph-{{ sid }}__btn--buy:hover { border-color: var(--gph-blush); background-color: var(--gph-blush-lt); }
  .gph-{{ sid }}__btn:focus-visible { outline: 2px solid var(--gph-accent); outline-offset: 3px; }

  .gph-{{ sid }}__trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 26px; }
  .gph-{{ sid }}__trust-item { display: flex; align-items: center; gap: 10px; }
  .gph-{{ sid }}__trust-icon { flex: 0 0 auto; color: var(--gph-accent); }
  .gph-{{ sid }}__trust-icon svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .gph-{{ sid }}__trust-text { font-size: 11.5px; line-height: 1.35; color: var(--gph-text); }

  {%- comment -%} CSS-only thumbnail switching {%- endcomment -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' -%}
      #gph-r-{{ sid }}-{{ forloop.index }}:checked ~ .gph-{{ sid }}__stage .gph-{{ sid }}__slide { opacity: 0; }
      #gph-r-{{ sid }}-{{ forloop.index }}:checked ~ .gph-{{ sid }}__stage .gph-{{ sid }}__slide-{{ forloop.index }} { opacity: 1; }
      #gph-r-{{ sid }}-{{ forloop.index }}:checked ~ .gph-{{ sid }}__thumbs .gph-{{ sid }}__thumb-{{ forloop.index }} { border-color: var(--gph-blush); border-width: 2px; }
    {%- endif -%}
  {%- endfor -%}

  @media (max-width: 749px) {
    .gph-{{ sid }}__inner { grid-template-columns: 1fr; gap: 24px; }
    .gph-{{ sid }}__trust { grid-template-columns: 1fr; gap: 10px; }
  }
</style>

<section class="gph-{{ sid }}" id="gph-{{ sid }}" aria-label="{{ product.title | escape }}">
  <div class="gph-{{ sid }}__inner">

    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="gph-{{ sid }}__gallery">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <input class="gph-{{ sid }}__sel" type="radio" name="gph-g-{{ sid }}" id="gph-r-{{ sid }}-{{ forloop.index }}"{% if forloop.first %} checked{% endif %}>
        {%- endif -%}
      {%- endfor -%}
      <div class="gph-{{ sid }}__stage">
        <span class="gph-{{ sid }}__zoom" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <div class="gph-{{ sid }}__slide gph-{{ sid }}__slide-{{ forloop.index }}">
                {{ media.preview_image | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager', widths: '600,900,1200,1400', sizes: '(max-width: 749px) 100vw, 50vw' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="gph-{{ sid }}__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gph-{{ sid }}__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <label class="gph-{{ sid }}__thumb gph-{{ sid }}__thumb-{{ forloop.index }}" for="gph-r-{{ sid }}-{{ forloop.index }}">
                {{ media.preview_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', widths: '120,180,240' }}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ============ PURCHASE PANEL ============ {%- endcomment -%}
    <div class="gph-{{ sid }}__panel">
      {%- assign subtitle = product.metafields.custom.subtitle | default: s.subtitle -%}
      {%- if s.badge != blank -%}<span class="gph-{{ sid }}__badge">{{ s.badge | escape }}</span>{%- endif -%}
      <h1 class="gph-{{ sid }}__title">{{ product.title | escape }}</h1>
      {%- if subtitle != blank -%}<p class="gph-{{ sid }}__subtitle">{{ subtitle | escape }}</p>{%- endif -%}

      <div class="gph-{{ sid }}__price-row">
        <span class="gph-{{ sid }}__price">{{ cur.price | money }}</span>
        {%- if has_compare -%}
          <span class="gph-{{ sid }}__compare">{{ cur.compare_at_price | money }}</span>
          {%- if s.show_savings -%}<span class="gph-{{ sid }}__saving">{{ s.savings_prefix | default: 'Risparmi' }} {{ saving | money }}</span>{%- endif -%}
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        {%- if s.options_title != blank -%}<p class="gph-{{ sid }}__opt-title">{{ s.options_title | escape }}</p>{%- endif -%}
        <div class="gph-{{ sid }}__options">
          {%- for block in section.blocks -%}
            {%- if block.type == 'option' -%}
              {%- assign op = block.settings.product -%}
              {%- liquid
                assign op_url = block.settings.link
                if op != blank and op_url == blank
                  assign op_url = op.url
                endif
                assign op_name = block.settings.label
                if op_name == blank and op != blank
                  assign op_name = op.title
                endif
                assign is_active = false
                if op != blank and op.id == product.id
                  assign is_active = true
                endif
              -%}
              <a class="gph-{{ sid }}__opt{% if is_active %} gph-{{ sid }}__opt--active{% endif %}"
                 {% if op_url != blank %}href="{{ op_url }}"{% else %}href="#"{% endif %}
                 {% if is_active %}aria-current="true"{% endif %}
                 {{ block.shopify_attributes }}>
                {%- if block.settings.badge != blank -%}<span class="gph-{{ sid }}__opt-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                <span class="gph-{{ sid }}__opt-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span class="gph-{{ sid }}__opt-name">{{ op_name | escape }}</span>
                <span class="gph-{{ sid }}__opt-price">{% if op != blank %}{{ op.price | money }}{% else %}{{ block.settings.price_text | escape }}{% endif %}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.bullets != blank -%}
        <ul class="gph-{{ sid }}__bullets">
          {%- assign bullet_lines = s.bullets | newline_to_br | split: '<br />' -%}
          {%- for line in bullet_lines -%}
            {%- assign cleaned = line | strip_newlines | strip -%}
            {%- if cleaned != blank -%}
              <li class="gph-{{ sid }}__bullet">
                <span class="gph-{{ sid }}__bullet-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span>{{ cleaned | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'product', product, id: form_id, class: form_class -%}
        <input type="hidden" name="id" value="{{ cur.id }}">
        <button type="submit" name="add" class="gph-{{ sid }}__btn gph-{{ sid }}__btn--add"{% unless product.available %} disabled{% endunless %}>
          {%- if product.available -%}{{ s.add_text | default: 'AGGIUNGI AL CARRELLO' | escape }}{%- else -%}{{ s.sold_out_text | default: 'ESAURITO' | escape }}{%- endif -%}
        </button>
        {%- if product.available -%}
          <button type="button" id="gph-buy-{{ sid }}" class="gph-{{ sid }}__btn gph-{{ sid }}__btn--buy">{{ s.buy_text | default: 'ACQUISTA ORA' | escape }}</button>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.show_trust -%}
        <div class="gph-{{ sid }}__trust">
          {%- for i in (1..3) -%}
            {%- assign ic_key = 'trust_icon_' | append: i -%}
            {%- assign tx_key = 'trust_text_' | append: i -%}
            {%- assign ic = section.settings[ic_key] -%}
            {%- assign tx = section.settings[tx_key] -%}
            {%- if tx != blank -%}
              <div class="gph-{{ sid }}__trust-item">
                <span class="gph-{{ sid }}__trust-icon" aria-hidden="true">
                  {%- case ic -%}
                    {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M1 4h13v11H1z"/><path d="M14 8h4l3 3v4h-7z"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>
                    {%- when 'returns' -%}<svg viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M3.5 13a8 8 0 1 0 2-8.5L3 7"/></svg>
                    {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
                    {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
                    {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z"/></svg>
                    {%- else -%}<svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                  {%- endcase -%}
                </span>
                <span class="gph-{{ sid }}__trust-text">{{ tx | escape | newline_to_br }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var buy = document.getElementById('gph-buy-{{ sid }}');
    var form = document.getElementById('gph-form-{{ sid }}');
    if (!buy || !form) return;
    buy.addEventListener('click', function () {
      if (buy.getAttribute('aria-busy') === 'true') return;
      buy.setAttribute('aria-busy', 'true');
      var data = new FormData(form);
      fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: data })
        .then(function (r) { if (!r.ok) { throw new Error('add failed'); } return r.json(); })
        .then(function () { window.location.href = '{{ routes.cart_url }}/checkout'; })
        .catch(function () { buy.removeAttribute('aria-busy'); form.submit(); });
    });
  })();
</script>

{% schema %}
{
  "name": "Grimmie product hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge above title", "default": "NUOVO ARRIVO" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle (fallback)", "info": "Per-product subtitle can be set via the product metafield custom.subtitle. This is the fallback.", "default": "Due misure. Più ordine, meno ingombro." },
    { "type": "checkbox", "id": "show_savings", "label": "Show savings badge (needs compare-at price)", "default": true },
    { "type": "text", "id": "savings_prefix", "label": "Savings prefix", "default": "Risparmi" },
    { "type": "text", "id": "options_title", "label": "Options title", "default": "Scegli la tua opzione" },
    { "type": "textarea", "id": "bullets", "label": "Bullet list (one per line)", "default": "Due misure perfette per ogni esigenza\nMateriali resistenti e facili da pulire\nIdeali per casa, viaggio e routine quotidiana" },
    { "type": "text", "id": "add_text", "label": "Add to cart text", "default": "AGGIUNGI AL CARRELLO" },
    { "type": "text", "id": "buy_text", "label": "Buy now text", "default": "ACQUISTA ORA" },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "default": "ESAURITO" },
    { "type": "range", "id": "thumb_columns", "label": "Thumbnail columns", "min": 3, "max": 6, "step": 1, "default": 4 },

    { "type": "header", "content": "Trust icons" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust row", "default": true },
    { "type": "select", "id": "trust_icon_1", "label": "Icon 1", "default": "truck", "options": [ { "value": "truck", "label": "Truck" }, { "value": "returns", "label": "Returns" }, { "value": "droplet", "label": "Droplet" }, { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "trust_text_1", "label": "Text 1", "default": "Spedizione gratuita da €75" },
    { "type": "select", "id": "trust_icon_2", "label": "Icon 2", "default": "returns", "options": [ { "value": "truck", "label": "Truck" }, { "value": "returns", "label": "Returns" }, { "value": "droplet", "label": "Droplet" }, { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "trust_text_2", "label": "Text 2", "default": "Resi facili entro 30 giorni" },
    { "type": "select", "id": "trust_icon_3", "label": "Icon 3", "default": "droplet", "options": [ { "value": "truck", "label": "Truck" }, { "value": "returns", "label": "Returns" }, { "value": "droplet", "label": "Droplet" }, { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" } ] },
    { "type": "text", "id": "trust_text_3", "label": "Text 3", "default": "Materiali lavabili e resistenti" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F1EE" },
    { "type": "color", "id": "panel_background_color", "label": "Panel background", "default": "#F7F1EE" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#6E5F59" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#6E5F59" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C99696" },
