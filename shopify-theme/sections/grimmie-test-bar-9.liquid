<div>T9 {{ section.id }}</div>

{% schema %}
{
  "name": "Grimmie Test 9",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Aria label", "default": "Annunci" },
    { "type": "checkbox", "id": "show_desktop", "label": "Desktop", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Mobile", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Animate", "default": true },
    { "type": "range", "id": "duration", "label": "Duration", "min": 10, "max": 120, "step": 5, "unit": "s", "default": 40 },
    { "type": "select", "id": "direction", "label": "Direction", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "select", "id": "divider_icon", "label": "Divider icon", "options": [
      { "value": "sparkle", "label": "Sparkle" },
      { "value": "star", "label": "Star" },
      { "value": "heart", "label": "Heart" },
      { "value": "dot", "label": "Dot" },
      { "value": "dotdash", "label": "Dot+dash" },
      { "value": "slash", "label": "Slash" }
    ], "default": "sparkle" },
    { "type": "color", "id": "bg_color", "label": "BG", "default": "#F7F1EE" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6E5F59" }
  ]
}
{% endschema %}
