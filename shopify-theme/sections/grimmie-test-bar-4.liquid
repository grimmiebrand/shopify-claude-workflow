<div>Ann bar test 4 {{ section.id }}</div>

{% schema %}
{
  "name": "Grimmie Scrolling Announcement",
  "tag": "section",
  "class": "grimmie-ann-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label (screen readers)",
      "default": "Annunci e vantaggi"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scrolling",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Loop duration (seconds)",
      "info": "Lower = faster scroll. Suggested 30\u201360.",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        {
          "value": "left",
          "label": "Right \u2192 Left"
        },
        {
          "value": "right",
          "label": "Left \u2192 Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Divider between messages"
    },
    {
      "type": "select",
      "id": "divider_icon",
      "label": "Divider icon",
      "options": [
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "dot",
          "label": "Dot"
        },
        {
          "value": "dotdash",
          "label": "Dot + dash"
        },
        {
          "value": "slash",
          "label": "Diagonal slash"
        }
      ],
      "default": "sparkle"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F7F1EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#6E5F59"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#6E5F59"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider icon",
      "default": "#EACBC8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border (top / bottom)",
      "default": "#DDD2CA"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 4,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 4,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between messages",
      "min": 16,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "divider_gap",
      "label": "Gap around divider",
      "min": 8,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography & icons"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ]
}
{% endschema %}