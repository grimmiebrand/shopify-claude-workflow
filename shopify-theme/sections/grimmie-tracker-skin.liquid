{%- comment -%}
  Grimmie tracker skin.
  Detects when the visitor is on the ParcelPanel hosted page
  (/apps/parcelpanel) and injects scoped CSS so the headings and form
  controls there match the Grimmie scale instead of inheriting Tinker's
  huge default heading sizes.

  This section has no visible output. Add it once to the header
  section group (already done via header-group.json) so it loads on
  every page.
{%- endcomment -%}

{%- liquid
  assign text_color  = section.settings.text_color  | default: '#6E5F59'
  assign accent      = section.settings.accent      | default: '#C99696'
  assign btn_bg      = section.settings.btn_bg      | default: '#EACBC8'
  assign btn_text    = section.settings.btn_text    | default: '#6E5F59'
  assign btn_hover   = section.settings.btn_hover   | default: '#DFAFB3'
  assign border      = section.settings.border      | default: '#DDD2CA'
  assign h1_max      = section.settings.h1_max      | default: 36
  assign h_max       = section.settings.h_max       | default: 22
  assign body_size   = section.settings.body_size   | default: 14
-%}

<script>
(function(){
  function mark(){
    var p = window.location.pathname || '';
    if (p.indexOf('/apps/parcelpanel') === 0) {
      document.documentElement.classList.add('grimmie-pp-page');
      if (document.body) document.body.classList.add('grimmie-pp-page');
    }
  }
  mark();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mark, { once: true });
  }
})();
</script>

<style data-grimmie-tracker-skin>
  /* Scoped to /apps/parcelpanel only */
  html.grimmie-pp-page h1,
  body.grimmie-pp-page h1 {
    font-size: clamp(22px, 2.6vw, {{ h1_max }}px) !important;
    line-height: 1.2 !important;
    letter-spacing: -0.005em !important;
    margin: 0.5em 0 !important;
    color: {{ text_color }};
  }
  html.grimmie-pp-page h2,
  html.grimmie-pp-page h3,
  html.grimmie-pp-page h4,
  html.grimmie-pp-page h5,
  html.grimmie-pp-page h6,
  body.grimmie-pp-page h2,
  body.grimmie-pp-page h3,
  body.grimmie-pp-page h4,
  body.grimmie-pp-page h5,
  body.grimmie-pp-page h6 {
    font-size: clamp(15px, 1.6vw, {{ h_max }}px) !important;
    line-height: 1.3 !important;
    letter-spacing: 0 !important;
    margin: 0.5em 0 !important;
    color: {{ text_color }};
    font-weight: 500 !important;
  }

  html.grimmie-pp-page p,
  html.grimmie-pp-page span,
  html.grimmie-pp-page label,
  html.grimmie-pp-page input,
  html.grimmie-pp-page select,
  html.grimmie-pp-page textarea,
  html.grimmie-pp-page button,
  html.grimmie-pp-page a,
  body.grimmie-pp-page p,
  body.grimmie-pp-page span,
  body.grimmie-pp-page label,
  body.grimmie-pp-page input,
  body.grimmie-pp-page select,
  body.grimmie-pp-page textarea,
  body.grimmie-pp-page button,
  body.grimmie-pp-page a {
    font-size: {{ body_size }}px !important;
    line-height: 1.5 !important;
    letter-spacing: 0.02em !important;
  }

  /* Submit / primary buttons inside the ParcelPanel UI */
  html.grimmie-pp-page button[type='submit'],
  html.grimmie-pp-page input[type='submit'],
  html.grimmie-pp-page .pp-button,
  body.grimmie-pp-page button[type='submit'],
  body.grimmie-pp-page input[type='submit'],
  body.grimmie-pp-page .pp-button {
    background-color: {{ btn_bg }} !important;
    color: {{ btn_text }} !important;
    border: none !important;
    border-radius: 8px !important;
    padding: 14px 24px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.18em !important;
    font-weight: 500 !important;
    min-height: 48px !important;
    cursor: pointer !important;
    transition: background-color 0.2s ease !important;
  }
  html.grimmie-pp-page button[type='submit']:hover,
  html.grimmie-pp-page input[type='submit']:hover,
  html.grimmie-pp-page .pp-button:hover,
  body.grimmie-pp-page button[type='submit']:hover,
  body.grimmie-pp-page input[type='submit']:hover,
  body.grimmie-pp-page .pp-button:hover {
    background-color: {{ btn_hover }} !important;
  }

  /* Inputs */
  html.grimmie-pp-page input[type='text'],
  html.grimmie-pp-page input[type='email'],
  html.grimmie-pp-page input[type='search'],
  body.grimmie-pp-page input[type='text'],
  body.grimmie-pp-page input[type='email'],
  body.grimmie-pp-page input[type='search'] {
    border: 1px solid {{ border }} !important;
    border-radius: 8px !important;
    padding: 12px 14px !important;
    min-height: 46px !important;
    color: {{ text_color }} !important;
  }

  /* Mobile: extra small clamp for headings to avoid wrapping nightmares */
  @media (max-width: 480px) {
    html.grimmie-pp-page h1,
    body.grimmie-pp-page h1 { font-size: 22px !important; }
    html.grimmie-pp-page h2,
    html.grimmie-pp-page h3,
    body.grimmie-pp-page h2,
    body.grimmie-pp-page h3 { font-size: 16px !important; }
  }
</style>

{% schema %}
{
  "name": "Grimmie tracker skin",
  "settings": [
    { "type": "paragraph", "content": "Forces sane heading and form sizes on the hosted ParcelPanel tracking page (/apps/parcelpanel). Add once to the header section group; no visible output." },

    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "h1_max",    "label": "H1 max size",   "min": 22, "max": 56, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "h_max",     "label": "H2–H6 max size","min": 14, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "body_size", "label": "Body text size","min": 12, "max": 18, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Body / heading text",   "default": "#6E5F59" },
    { "type": "color", "id": "border",     "label": "Input borders",         "default": "#DDD2CA" },
    { "type": "color", "id": "accent",     "label": "Accent",                "default": "#C99696" },
    { "type": "color", "id": "btn_bg",     "label": "Primary button bg",     "default": "#EACBC8" },
    { "type": "color", "id": "btn_text",   "label": "Primary button text",   "default": "#6E5F59" },
    { "type": "color", "id": "btn_hover",  "label": "Primary button hover",  "default": "#DFAFB3" }
  ],
  "presets": [
    { "name": "Grimmie tracker skin", "category": "Grimmie" }
  ]
}
{% endschema %}
