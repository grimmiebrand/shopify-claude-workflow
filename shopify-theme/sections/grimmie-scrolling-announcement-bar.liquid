{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign duration = s.duration | default: 40
  assign animate = s.animate
  assign pause = s.pause_on_hover
  assign direction = s.direction | default: 'left'
  assign item_gap = s.item_gap | default: 56
  assign divider_gap = s.divider_gap | default: 32
  assign text_size = s.text_size | default: 13
  assign text_weight = s.text_weight | default: '400'
  assign icon_size = s.icon_size | default: 14
  assign show_msg_icons_master = s.show_message_icons
  assign pad_top = s.padding_top | default: 12
  assign pad_bottom = s.padding_bottom | default: 12
-%}

<style>
  .grimmie-ann-{{ sid }} {
    --gann-bg: {{ s.bg_color }};
    --gann-text: {{ s.text_color }};
    --gann-icon: {{ s.icon_color }};
    --gann-divider: {{ s.divider_color }};
    --gann-border: {{ s.border_color }};
    --gann-duration: {{ duration }}s;
    --gann-item-gap: {{ item_gap }}px;
    --gann-divider-gap: {{ divider_gap }}px;
    --gann-text-size: {{ text_size }}px;
    --gann-text-weight: {{ text_weight }};
    --gann-icon-size: {{ icon_size }}px;
    --gann-shift: -50%;
    --gann-pad-top: {{ pad_top }}px;
    --gann-pad-bottom: {{ pad_bottom }}px;

    position: relative;
    width: 100%;
    background-color: var(--gann-bg);
    color: var(--gann-text);
    overflow: hidden;
    padding: var(--gann-pad-top) 0 var(--gann-pad-bottom);
    font-family: var(--font-body--family, inherit);
    {% if s.show_top_border %}border-top: 1px solid var(--gann-border);{% endif %}
    {% if s.show_bottom_border %}border-bottom: 1px solid var(--gann-border);{% endif %}
  }

  {%- unless s.show_desktop -%}
    @media (min-width: 750px) { .grimmie-ann-{{ sid }} { display: none; } }
  {%- endunless -%}
  {%- unless s.show_mobile -%}
    @media (max-width: 749.98px) { .grimmie-ann-{{ sid }} { display: none; } }
  {%- endunless -%}

  .grimmie-ann-{{ sid }}__viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
            mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent);
  }
  .grimmie-ann-{{ sid }}__track {
    display: flex;
    align-items: center;
    gap: var(--gann-item-gap);
    width: max-content;
    will-change: transform;
    {% if animate %}animation: grimmie-ann-{{ sid }}-scroll var(--gann-duration) linear infinite;{% endif %}
    {% if direction == 'right' %}animation-direction: reverse;{% endif %}
  }
  {% if pause %}
  .grimmie-ann-{{ sid }}:hover .grimmie-ann-{{ sid }}__track,
  .grimmie-ann-{{ sid }}:focus-within .grimmie-ann-{{ sid }}__track { animation-play-state: paused; }
  {% endif %}
  .grimmie-ann-{{ sid }}__list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--gann-item-gap);
    flex-shrink: 0;
  }
  .grimmie-ann-{{ sid }}__item {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .grimmie-ann-{{ sid }}__item--divider { color: var(--gann-divider); }
  .grimmie-ann-{{ sid }}__msg {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--gann-divider-gap) / 3);
    font-size: var(--gann-text-size);
    font-weight: var(--gann-text-weight);
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--gann-text);
  }
  .grimmie-ann-{{ sid }}__msg:not(:has(.grimmie-ann-{{ sid }}__icon)) { gap: 0; }
  a.grimmie-ann-{{ sid }}__msg { text-decoration: none; }
  a.grimmie-ann-{{ sid }}__msg:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .grimmie-ann-{{ sid }}__icon,
  .grimmie-ann-{{ sid }}__divider {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .grimmie-ann-{{ sid }}__icon { width: var(--gann-icon-size); height: var(--gann-icon-size); color: var(--gann-icon); }
  .grimmie-ann-{{ sid }}__divider { width: calc(var(--gann-icon-size) * 0.85); height: calc(var(--gann-icon-size) * 0.85); color: var(--gann-divider); }
  .grimmie-ann-{{ sid }}__icon svg,
  .grimmie-ann-{{ sid }}__divider svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; display: block; }
  .grimmie-ann-{{ sid }}__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .grimmie-ann-{{ sid }}__item--divider .grimmie-ann-{{ sid }}__divider svg circle[fill="currentColor"] { fill: currentColor; }

  @keyframes grimmie-ann-{{ sid }}-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(var(--gann-shift, -50%)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .grimmie-ann-{{ sid }}__track { animation: none !important; transform: none !important; }
    .grimmie-ann-{{ sid }}__viewport { -webkit-mask-image: none; mask-image: none; }
    .grimmie-ann-{{ sid }}__track { justify-content: center; flex-wrap: wrap; row-gap: 6px; }
    .grimmie-ann-{{ sid }}__list { flex-wrap: wrap; justify-content: center; }
  }

  @media (max-width: 749.98px) {
    .grimmie-ann-{{ sid }} { --gann-item-gap: calc({{ item_gap }}px * 0.7); --gann-divider-gap: calc({{ divider_gap }}px * 0.75); }
  }
</style>

{%- capture grimmie_ann_icon_truck -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7 h11 v9 h-11 z"/><path d="M14 10 h4 l2 3 v3 h-6 z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_return -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12 a7 7 0 1 1 2.05 4.95"/><path d="M5 7 V12 H10"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_lock -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10 V7 a4 4 0 0 1 8 0 V10"/><circle cx="12" cy="15" r="1"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_shield -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 L20 6 V12 c0 5 -4 8 -8 9 c-4 -1 -8 -4 -8 -9 V6 Z"/><path d="M9 12 l2 2 l4 -4"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_sparkle -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 L13.5 9 L19 10.5 L13.5 12 L12 18 L10.5 12 L5 10.5 L10.5 9 Z"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_heart -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20 C 7 16 4 13 4 9 a 3.5 3.5 0 0 1 7 -1 a 3.5 3.5 0 0 1 7 1 c 0 4 -3 7 -8 11 Z"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_pouch -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9 h14 l-1.5 11 h-11 z"/><path d="M8 9 V7 a4 4 0 0 1 8 0 V9"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_gift -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="1"/><path d="M3 7 h18 v3 h-18 z M12 7 v13"/><path d="M12 7 c -3 0 -4 -3 -2 -4 c 2 -1 3 2 2 4 z M12 7 c 3 0 4 -3 2 -4 c -2 -1 -3 2 -2 4 z"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_check -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 L11 15.5 L16 9.5"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_star -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 L14 9 H20 L15 13 L17 19 L12 15 L7 19 L9 13 L4 9 H10 Z"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_dot -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_slash -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 4 L8 20"/></svg>{%- endcapture -%}
{%- capture grimmie_ann_icon_dotdash -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M3 12 H7 M17 12 H21"/></svg>{%- endcapture -%}

{%- liquid
  case s.divider_icon
    when 'sparkle'
      assign divider_svg = grimmie_ann_icon_sparkle
    when 'star'
      assign divider_svg = grimmie_ann_icon_star
    when 'heart'
      assign divider_svg = grimmie_ann_icon_heart
    when 'dot'
      assign divider_svg = grimmie_ann_icon_dot
    when 'slash'
      assign divider_svg = grimmie_ann_icon_slash
    when 'dotdash'
      assign divider_svg = grimmie_ann_icon_dotdash
    else
      assign divider_svg = grimmie_ann_icon_sparkle
  endcase
-%}

<section id="grimmie-ann-{{ sid }}-root" class="grimmie-ann-{{ sid }}" aria-label="{{ s.aria_label | default: 'Annunci e vantaggi' | escape }}">
  <div class="grimmie-ann-{{ sid }}__viewport">
    <div class="grimmie-ann-{{ sid }}__track" data-gann-track>
      <ul class="grimmie-ann-{{ sid }}__list" data-gann-list>
        {%- for block in section.blocks -%}
          {%- if block.type == 'message' -%}
            {%- assign txt = block.settings.text -%}
            {%- assign block_show_icon = block.settings.show_icon -%}
            {%- assign show_icon = false -%}
            {%- if show_msg_icons_master and block_show_icon -%}{%- assign show_icon = true -%}{%- endif -%}
            {%- assign link = block.settings.link -%}
            {%- assign open_blank = block.settings.open_new_tab -%}
            {%- assign uploaded_icon = block.settings.icon_image -%}
            {%- assign icon_alt = block.settings.icon_alt | default: '' -%}
            {%- liquid
              case block.settings.icon_fallback
                when 'truck'
                  assign msg_icon_svg = grimmie_ann_icon_truck
                when 'return'
                  assign msg_icon_svg = grimmie_ann_icon_return
                when 'lock'
                  assign msg_icon_svg = grimmie_ann_icon_lock
                when 'shield'
                  assign msg_icon_svg = grimmie_ann_icon_shield
                when 'sparkle'
                  assign msg_icon_svg = grimmie_ann_icon_sparkle
                when 'heart'
                  assign msg_icon_svg = grimmie_ann_icon_heart
                when 'pouch'
                  assign msg_icon_svg = grimmie_ann_icon_pouch
                when 'gift'
                  assign msg_icon_svg = grimmie_ann_icon_gift
                when 'check'
                  assign msg_icon_svg = grimmie_ann_icon_check
                else
                  assign msg_icon_svg = grimmie_ann_icon_sparkle
              endcase
            -%}
            <li class="grimmie-ann-{{ sid }}__item grimmie-ann-{{ sid }}__item--msg">
              {%- if link != blank -%}
                <a class="grimmie-ann-{{ sid }}__msg" href="{{ link }}"{% if open_blank %} target="_blank" rel="noopener"{% endif %}>
              {%- else -%}
                <span class="grimmie-ann-{{ sid }}__msg">
              {%- endif -%}
                {%- if show_icon -%}
                  <span class="grimmie-ann-{{ sid }}__icon" {% if icon_alt != blank %}aria-label="{{ icon_alt | escape }}"{% else %}aria-hidden="true"{% endif %}>
                    {%- if uploaded_icon != blank -%}
                      {{ uploaded_icon | image_url: width: 80 | image_tag: alt: icon_alt, loading: 'lazy' }}
                    {%- else -%}
                      {{ msg_icon_svg }}
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <span>{{ txt | escape }}</span>
              {%- if link != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </li>
            <li class="grimmie-ann-{{ sid }}__item grimmie-ann-{{ sid }}__item--divider" aria-hidden="true">
              <span class="grimmie-ann-{{ sid }}__divider">{{ divider_svg }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('grimmie-ann-{{ sid }}-root');
  if (!root) return;
  var track = root.querySelector('[data-gann-track]');
  var firstList = root.querySelector('[data-gann-list]');
  if (!track || !firstList) return;

  function fit(){
    // strip prior clones
    var lists = track.querySelectorAll('[data-gann-list]');
    for (var i = 1; i < lists.length; i++) lists[i].parentNode.removeChild(lists[i]);

    var listW = firstList.scrollWidth;
    var viewW = root.clientWidth;
    if (!listW || !viewW) return;

    // We need enough copies so that, after translating by exactly 1 list width,
    // the viewport is still fully covered. Need: copies * listW >= viewW + listW
    var copies = Math.max(2, Math.ceil(viewW / listW) + 1);

    for (var j = 1; j < copies; j++){
      var clone = firstList.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.removeAttribute('data-gann-list');
      clone.setAttribute('data-gann-list', '');
      track.appendChild(clone);
    }

    root.style.setProperty('--gann-shift', '-' + (100 / copies).toFixed(4) + '%');
  }

  // Re-fit when fonts settle or layout changes
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(fit, fit);
  }
  fit();

  var resizeTimer;
  window.addEventListener('resize', function(){
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(fit, 150);
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Grimmie scrolling bar",
  "tag": "section",
  "class": "grimmie-ann-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Aria label (screen readers)", "default": "Annunci e vantaggi" },

    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Show on mobile", "default": true },

    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "animate", "label": "Enable scrolling", "default": true },
    { "type": "range", "id": "duration", "label": "Loop duration (seconds)", "info": "Lower = faster scroll. Suggested 30–60.", "min": 10, "max": 120, "step": 5, "unit": "s", "default": 40 },
    { "type": "select", "id": "direction", "label": "Scroll direction", "options": [
      { "value": "left", "label": "Right → Left" }, { "value": "right", "label": "Left → Right" }
    ], "default": "left" },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },

    { "type": "header", "content": "Divider between messages" },
    { "type": "select", "id": "divider_icon", "label": "Divider icon", "options": [
      { "value": "sparkle",  "label": "Sparkle" },
      { "value": "star",     "label": "Star" },
      { "value": "heart",    "label": "Heart" },
      { "value": "dot",      "label": "Dot" },
      { "value": "dotdash",  "label": "Dot + dash" },
      { "value": "slash",    "label": "Diagonal slash" }
    ], "default": "sparkle" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color",       "label": "Background",            "default": "#F7F1EE" },
    { "type": "color", "id": "text_color",     "label": "Text",                  "default": "#6E5F59" },
    { "type": "color", "id": "icon_color",     "label": "Icon",                  "default": "#6E5F59" },
    { "type": "color", "id": "divider_color",  "label": "Divider icon",          "default": "#EACBC8" },
    { "type": "color", "id": "border_color",   "label": "Border (top / bottom)", "default": "#DDD2CA" },

    { "type": "header", "content": "Borders" },
    { "type": "checkbox", "id": "show_top_border",    "label": "Show top border",    "default": false },
    { "type": "checkbox", "id": "show_bottom_border", "label": "Show bottom border", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",          "min": 4,  "max": 32,  "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom",       "min": 4,  "max": 32,  "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "item_gap",       "label": "Gap between messages", "min": 16, "max": 160, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "divider_gap",    "label": "Gap around divider",   "min": 8,  "max": 80,  "step": 1, "unit": "px", "default": 24 },

    { "type": "header", "content": "Typography & icons" },
    { "type": "checkbox", "id": "show_message_icons", "label": "Show message icons (master)", "info": "Turn off to hide all icons and remove their spacing.", "default": true },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "select", "id": "text_weight", "label": "Text font weight", "options": [
      { "value": "400", "label": "Regular" },
      { "value": "500", "label": "Medium" },
      { "value": "600", "label": "Semi-bold" },
      { "value": "700", "label": "Bold" }
    ], "default": "400" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 14 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Spedizione gratuita sopra i 60€" },
        { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (overrides fallback)", "info": "SVG or PNG with transparent background, ~80×80. Leave empty to use the fallback icon." },
        { "type": "select", "id": "icon_fallback", "label": "Fallback icon", "options": [
          { "value": "truck",   "label": "Truck (shipping)" },
          { "value": "return",  "label": "Return arrow" },
          { "value": "lock",    "label": "Lock" },
          { "value": "shield",  "label": "Shield" },
          { "value": "sparkle", "label": "Sparkle" },
          { "value": "heart",   "label": "Heart" },
          { "value": "pouch",   "label": "Pouch" },
          { "value": "gift",    "label": "Gift" },
          { "value": "check",   "label": "Check" }
        ], "default": "truck" },
        { "type": "text", "id": "icon_alt", "label": "Icon alt text", "info": "Optional. Leave empty to mark the icon as decorative." },
        { "type": "url",  "id": "link", "label": "Link (optional)" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open link in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grimmie scrolling bar",
      "category": "Grimmie",
      "blocks": [
        { "type": "message", "settings": { "text": "Spedizione gratuita sopra i 60€", "icon_fallback": "truck" } },
        { "type": "message", "settings": { "text": "Resi fino a 30 giorni",           "icon_fallback": "return" } },
        { "type": "message", "settings": { "text": "Pagamenti sicuri e protetti",     "icon_fallback": "lock" } }
      ]
    }
  ]
}
{% endschema %}
